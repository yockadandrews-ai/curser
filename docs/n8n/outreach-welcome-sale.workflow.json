{
  "name": "Money Autopilot — Outreach Welcome + Sale Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "outreach-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-outreach",
      "name": "Webhook — Outreach Events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "money-autopilot-outreach"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "subscribe",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "subscribe"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "checkout_completed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sale"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-event-type",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "Your Profit Tracker is ready (+ what's next)",
        "message": "=Welcome to Money Magnet Tools.\n\nStart here: {{ $env.TOOLS_BASE_URL || 'https://tools.moneymagnettools.com' }}/tracker.html\n\nLog today's AdSense or affiliate click in 30 seconds. Tomorrow I'll show you the 5-minute autopilot loop.\n\n— Money Autopilot",
        "options": {}
      },
      "id": "gmail-welcome-0",
      "name": "Gmail — Welcome Day 0",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, -120],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_ME",
          "name": "Gmail — outreach"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $env.FOUNDER_EMAIL || 'founder@example.com' }}",
        "subject": "=🎉 Engine sale — {{ $json.body.email }} (${{ $json.body.amount }})",
        "message": "=New Money Autopilot Engine sale\n\nEmail: {{ $json.body.email }}\nAmount: ${{ $json.body.amount }}\nSession: {{ $json.body.sessionId }}\n\nCustomer should open Approval Inbox:\n{{ $json.body.approveUrl }}\n\nSent=0 until they approve drafts manually.",
        "options": {}
      },
      "id": "gmail-sale-notify",
      "name": "Gmail — Founder Sale Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 120],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_ME",
          "name": "Gmail — outreach"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "Welcome to Money Autopilot Engine 🚀",
        "message": "=Thanks for your purchase!\n\nOpen your Approval Inbox to review your first drafts:\n{{ $json.body.approveUrl }}\n\nDashboard: {{ $json.body.dashboardUrl }}\n\nDraft free, send gated — nothing posts without you.\n\n— Money Autopilot",
        "options": {}
      },
      "id": "gmail-buyer-welcome",
      "name": "Gmail — Buyer Onboarding",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, 120],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_ME",
          "name": "Gmail — outreach"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.APP_BASE_URL || 'http://localhost:3001') + '/api/hermes/ingest' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"n8n\",\n  \"title\": \"Outreach: {{ $json.body.type }}\",\n  \"summary\": \"{{ $json.body.email || 'unknown' }}\",\n  \"payload\": {{ JSON.stringify($json.body) }}\n}",
        "options": {}
      },
      "id": "http-hermes-log",
      "name": "HTTP — Log to Hermes (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 280]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"received\": \"{{ $json.body.type }}\" }",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 0]
    }
  ],
  "connections": {
    "Webhook — Outreach Events": {
      "main": [[{ "node": "Route by Event Type", "type": "main", "index": 0 }]]
    },
    "Route by Event Type": {
      "main": [
        [{ "node": "Gmail — Welcome Day 0", "type": "main", "index": 0 }],
        [
          { "node": "Gmail — Founder Sale Alert", "type": "main", "index": 0 },
          { "node": "HTTP — Log to Hermes (optional)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Gmail — Welcome Day 0": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Gmail — Founder Sale Alert": {
      "main": [[{ "node": "Gmail — Buyer Onboarding", "type": "main", "index": 0 }]]
    },
    "Gmail — Buyer Onboarding": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": [
    { "name": "Money Autopilot" },
    { "name": "Outreach" }
  ]
}
