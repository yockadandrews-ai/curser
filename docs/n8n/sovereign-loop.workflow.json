{
  "name": "Sovereign Sales Autopilot — SG3 → Hermes → Ling → K3",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sovereign-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "sovereign-inbound"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3001' }}/api/sovereign/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.body.channel || 'email', name: $json.body.name, email: $json.body.email, company: $json.body.company, message: $json.body.message }) }}"
      },
      "id": "hermes-ingest",
      "name": "Hermes — Ingest Inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "score-ling",
              "leftValue": "={{ $json.route }}",
              "rightValue": "ling",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "route-ling",
      "name": "Score ≥7 → Ling",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3001' }}/api/sovereign/tickets/{{ $json.ticket.id }}/qualify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.qualifyAnswers) }}"
      },
      "id": "hermes-qualify",
      "name": "Hermes — Qualify (after 3 Q)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL || 'http://localhost:3001' }}/api/sovereign/tickets/{{ $json.ticket.id }}/sign",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}"
      },
      "id": "k3-deploy",
      "name": "K3 — Deploy on Signature",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 0]
    }
  ],
  "connections": {
    "Inbound Webhook": {
      "main": [[{ "node": "Hermes — Ingest Inbound", "type": "main", "index": 0 }]]
    },
    "Hermes — Ingest Inbound": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    },
    "Hermes — Qualify (after 3 Q)": {
      "main": [[{ "node": "Score ≥7 → Ling", "type": "main", "index": 0 }]]
    },
    "Score ≥7 → Ling": {
      "main": [
        [{ "node": "K3 — Deploy on Signature", "type": "main", "index": 0 }],
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "K3 — Deploy on Signature": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Sovereign loop handoffs: inbound → Hermes qualify → Ling close → K3 deploy → SG3 case study. Draft only until founder approval."
  }
}
