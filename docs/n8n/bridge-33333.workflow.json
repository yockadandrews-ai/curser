    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "key", "value": "={{ $env.GEMINI_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Act as the 33333 Content Generator. Given niche {{ $('Determine Element Block').item.json.campaign }} and platforms {{ $json.platforms }}, generate 5 ideas per platform. Also generate 1 AuraFlow theme (element: Air, slot 11:11) and 1 VaultVerse theme (element: Fire, slot 15:33). Return strict JSON only: { content_ideas: [{name, ideas}], auraflow_payload: {theme, element, slot}, vaultverse_payload: {theme, element, slot} }\"\n    }]\n  }]\n}"
      },
      "id": "air-gemini",
      "name": "Air — Gemini Content Ideas (W1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed = raw;\ntry {\n  const text = raw.candidates?.[0]?.content?.parts?.[0]?.text ?? '{}';\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : {};\n} catch (e) { parsed = {}; }\n\nconst clock = $('Determine Element Block').first().json;\nconst rows = [];\nconst ideas = parsed.content_ideas ?? [];\n\nideas.forEach(platform => {\n  (platform.ideas ?? []).forEach(topic => {\n    rows.push({\n      id: `CI_${Date.now()}_${Math.floor(Math.random()*1000)}`,\n      platform: platform.name,\n      topic,\n      status: 'idea',\n      brand: platform.name === 'YouTube' ? 'VaultVerse' : 'AuraFlow',\n      source_element: 'Air',\n      date_created: new Date().toISOString(),\n      link: null,\n    });\n  });\n});\n\nreturn [{\n  json: {\n    rows,\n    ideas_count: rows.length,\n    auraflow_payload: parsed.auraflow_payload ?? {},\n    vaultverse_payload: parsed.vaultverse_payload ?? {},\n    day: clock.day,\n    dateStr: clock.dateStr,\n  }\n}];"
      },
